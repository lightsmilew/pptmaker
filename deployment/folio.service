[Unit]
Description=Folio Studio API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=folio
Group=folio
WorkingDirectory=/var/lib/folio
ExecStart=/opt/folio/current/.venv/bin/folio-server --env-file /etc/folio/runtime/folio.env --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/folio /etc/folio/runtime

[Install]
WantedBy=multi-user.target
