# Copy to /etc/folio/runtime/folio.env (owner folio, mode 0600).
APP_NAME=Folio Studio
DEBUG=false
STORAGE_PATH=/var/lib/folio/storage
FOLIO_DB=/var/lib/folio/folio.sqlite3
MAX_FILE_SIZE=10485760
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_MAX_TOKENS=12000
OPENAI_TEMPERATURE=0.7
DEEPSEEK_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=90
LLM_JSON_MODE=auto
LLM_PROMPT_CACHE_KEY=off
ANTHROPIC_PROMPT_CACHE=off
PPT_CONCURRENCY=3
PPT_REVIEW_MODE=local
PPT_MAX_REVIEW_ROUNDS=2
FOLIO_SESSION_DAYS=7
FOLIO_COOKIE_SECURE=true
FOLIO_ALLOWED_ORIGINS=https://@@DOMAIN@@
FOLIO_REGISTRATION_ENABLED=true
# Authenticated budgets are managed by membership plans / per-user overrides.
# Anthropic: change LLM_PROVIDER and set ANTHROPIC_API_KEY / MODEL / BASE_URL.
