# Folio Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Folio Studio
DEBUG=true

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760

# PPT Defaults
DEFAULT_PAGE_COUNT=8
MAX_PAGE_COUNT=50
DEFAULT_STYLE=商务简约

# ===========================================
# LLM Provider Configuration
# ===========================================
# Supported providers: openai, anthropic
LLM_PROVIDER=openai

# -------------------------------------------
# OpenAI Configuration
# -------------------------------------------
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=12000
# This is a ceiling, not the output target: writer=1000/1400, parser=650,
# planner=max(2200,page_count*240), enough for the 50-page upper limit.
DEEPSEEK_REASONING_EFFORT=none
# Optional per-stage model / reasoning overrides, e.g.:
# OPENAI_PLANNER_MODEL=deepseek-v4-pro
# DEEPSEEK_PLANNER_EFFORT=low

# -------------------------------------------
# Anthropic Configuration
# -------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=12000

# Runtime / review / provider capabilities
PPT_CONCURRENCY=3
# Adjustments after the initial review (1–4). Advice does not block usable export.
PPT_MAX_REVIEW_ROUNDS=2
PPT_REVIEW_MODE=local
LLM_TIMEOUT_SECONDS=90
LLM_JSON_MODE=auto
LLM_PROMPT_CACHE_KEY=off
ANTHROPIC_PROMPT_CACHE=off
# Server accounts: registration defaults to Basic. Administer each user's
# membership / quota using python scripts/manage_user.py from the repo root.
FOLIO_SESSION_DAYS=7
FOLIO_COOKIE_SECURE=false
# Production: use your exact HTTPS site origin and set COOKIE_SECURE=true.
FOLIO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
# Default output-token budget per user per UTC month; 0 means unlimited.
# A per-user admin override takes priority. Parallel calls reserve
# their stage budget before dispatch, then reconcile actual usage.
FOLIO_MONTHLY_OUTPUT_LIMIT=0
# FOLIO_DB=./storage/folio.sqlite3
# Vision requires image support; outages fall back to local checks with a warning.
# Enable LLM_PROMPT_CACHE_KEY for a provider that supports this parameter.

# ===========================================
# Example Configurations
# ===========================================

# Example 1: Using official OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Example 2: Using Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Example 3: Using custom OpenAI-compatible endpoint (e.g., local model)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3
