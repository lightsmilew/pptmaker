# Folio Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Folio Studio
DEBUG=true

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760

# PPT Defaults
DEFAULT_PAGE_COUNT=8
MAX_PAGE_COUNT=50
DEFAULT_STYLE=商务简约

# ===========================================
# LLM Provider Configuration
# ===========================================
# Supported providers: openai, anthropic
LLM_PROVIDER=openai

# -------------------------------------------
# OpenAI Configuration
# -------------------------------------------
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=12000
# This is a ceiling, not the output target: writer=1000/1400, parser=650,
# planner=max(2200,page_count*240), enough for the 50-page upper limit.
DEEPSEEK_REASONING_EFFORT=none
# Optional per-stage model / reasoning overrides, e.g.:
# OPENAI_PLANNER_MODEL=deepseek-v4-pro
# DEEPSEEK_PLANNER_EFFORT=low

# -------------------------------------------
# Anthropic Configuration
# -------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=12000

# Runtime / review / provider capabilities
PPT_CONCURRENCY=3
PPT_MAX_REVIEW_ROUNDS=2
PPT_REVIEW_MODE=local
LLM_TIMEOUT_SECONDS=90
LLM_JSON_MODE=auto
LLM_PROMPT_CACHE_KEY=off
ANTHROPIC_PROMPT_CACHE=off
# Local account and entitlements: no payment integration or provider balance.
FOLIO_MEMBERSHIP=local
# Set plus to display local VIP entitlements; optional ISO timestamp expiration.
# FOLIO_MEMBERSHIP_EXPIRES_AT=2027-01-01T00:00:00+00:00
# Output-token budget per UTC month; 0 means unlimited. Parallel calls reserve
# their stage budget before dispatch, then reconcile actual usage.
FOLIO_MONTHLY_OUTPUT_LIMIT=0
# FOLIO_DB=./storage/folio.sqlite3
# Set PPT_REVIEW_MODE=vision only when the model supports image input.
# Enable LLM_PROMPT_CACHE_KEY for a provider that supports this parameter.

# ===========================================
# Example Configurations
# ===========================================

# Example 1: Using official OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Example 2: Using Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Example 3: Using custom OpenAI-compatible endpoint (e.g., local model)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3
