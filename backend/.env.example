# PPTMaker Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=PPTMaker Agent
DEBUG=true

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760

# PPT Defaults
DEFAULT_PAGE_COUNT=8
MAX_PAGE_COUNT=50
DEFAULT_STYLE=商务简约

# ===========================================
# LLM Provider Configuration
# ===========================================
# Supported providers: openai, anthropic
LLM_PROVIDER=openai

# -------------------------------------------
# OpenAI Configuration
# -------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1048576

# -------------------------------------------
# Anthropic Configuration
# -------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=1048576

# ===========================================
# Example Configurations
# ===========================================

# Example 1: Using OpenAI (default)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Example 2: Using Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Example 3: Using custom OpenAI-compatible endpoint (e.g., local model)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3
